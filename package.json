{
  "name": "atlas-image-quiz",
  "version": "1.0.3",
  "description": "A local-first image landmark quiz app",
  "author": "Atlas",
  "private": true,
  "main": "main.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:mac:arm64": "electron-builder --mac dmg zip --arm64",
    "dist:mac:x64": "electron-builder --mac dmg zip --x64",
    "check": "node --check main.js && node --check server.js && node --check app.js && node --check data-migration.js",
    "test": "node --test"
  },
  "build": {
    "appId": "com.atlas.imagequiz",
    "productName": "Atlas",
    "asar": true,
    "files": [
      "main.js",
      "data-migration.js",
      "server.js",
      "app.js",
      "index.html",
      "styles.css",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  }
}
